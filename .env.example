# .env — Supabase (로컬·공통)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PartyKit cold start 시 rooms.y_snapshot 로드 (party/loadRoomSnapshot.ts)
# 로컬 partykit dev 는 아래 VITE_* 값도 자동으로 읽습니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# PartyKit 프로덕션 호스트는 Vercel env 에만 두는 것을 권장합니다.
# 로컬 dev 는 .env.development 가 localhost:1999 를 사용합니다.
